app_identifier("com.mori.downloader")  # Bundle ID
apple_id("YOUR_APPLE_ID@email.com")    # Apple ID untuk App Store Connect
team_id("YOUR_TEAM_ID")                # Team ID (10 karakter, dari developer.apple.com)
itc_team_id("YOUR_ITC_TEAM_ID")        # iTunes Connect Team ID (opsional, biasanya sama dengan team_id)

