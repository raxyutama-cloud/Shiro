[Unit]
Description=Shiro QRIS proxy (token buatqris.site tetap di server)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/qris-proxy
EnvironmentFile=/var/www/qris-proxy/.env
ExecStart=/usr/bin/node /var/www/qris-proxy/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
