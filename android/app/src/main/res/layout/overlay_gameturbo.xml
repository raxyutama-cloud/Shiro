<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#CC1E1E1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/overlay_bg">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:paddingBottom="8dp"
            android:borderBottom="@drawable/divider_line">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gameturbo_logo"
                android:tint="@color/gameturbo_primary"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Turbo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/overlay_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                android:tint="@android:color/white"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- FPS (Large) -->
        <TextView
            android:id="@+id/overlay_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/gameturbo_primary"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider_line"
            android:layout_marginVertical="8dp"/>

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/overlay_cpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU: 45% 2400MHz"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/overlay_gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPU: 850MHz"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/overlay_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temp: 42°C"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/overlay_ram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAM: 2.1/4.0 GB"
                android:textSize="12sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>