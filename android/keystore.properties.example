# =============================================================================
# Android Signing Config — JANGAN COMMIT FILE INI KE GIT!
# Copy ke android/keystore.properties dan isi dengan nilai asli
# =============================================================================

# Path ke file keystore (relatif dari android/ atau absolut)
storeFile=../shiro-release-key.jks

# Password keystore
storePassword=YOUR_STORE_PASSWORD

# Key alias
keyAlias=shiro

# Password key (bisa sama dengan storePassword)
keyPassword=YOUR_KEY_PASSWORD